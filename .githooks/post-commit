#!/bin/sh
#
# Warn when a commit lands on master/main by a route pre-commit cannot refuse.
#
# OPT-IN alongside pre-commit:
#     git config core.hooksPath .githooks
#
# `git cherry-pick` and `git revert` author brand-new commits WITHOUT running pre-commit —
# measured, not assumed: a cherry-pick onto master completed silently while pre-commit was
# installed and active. pre-commit's docstring used to claim it enforced "no commits authored
# on master", which was therefore overstated.
#
# This hook covers cherry-pick ONLY. `git revert` does not run post-commit either (measured),
# so it is unguarded by any hook — see the SCOPE note below.
#
# post-commit runs after the fact and cannot refuse anything, so this does not pretend to
# block. It tells you what just landed and how to undo it, which is the most a hook can do
# for these routes. Exits 0 always — a post-commit failure would not un-commit anything and
# would only add noise.

branch=$(git symbolic-ref --short -q HEAD) || exit 0

case "$branch" in
  master|main) ;;
  *) exit 0 ;;
esac

# Only speak up for the routes pre-commit could not intercept. An ordinary `git commit` on
# master was already refused by pre-commit, so reaching here means --no-verify was used
# deliberately, and nagging about a deliberate choice is noise.
#
# SCOPE — measured, and narrower than two earlier versions of this comment claimed:
#
#   git cherry-pick   post-commit RUNS. CHERRY_PICK_HEAD is still present, so the ref test
#                     below fires. Verified: 1 warning line.
#   git revert        post-commit is NOT RUN AT ALL. Verified by instrumenting this file with
#                     an unconditional `echo` — it never printed. So revert cannot be caught
#                     from here by any detection logic, message-shape or otherwise; the
#                     earlier attempt to cover it with a `^Revert "` grep was treating a
#                     hook-invocation gap as a pattern-matching gap.
#
# The `^Revert "` match is kept anyway, because it costs nothing and DOES fire on the one
# route that reaches here with that message shape: `git cherry-pick` of a commit that was
# itself a revert. It is not what makes `git revert` covered — nothing here can.
#
# `git revert` on master therefore remains genuinely UNGUARDED. pre-commit says so, and
# CONTRIBUTING says so. A hook cannot close it; only `git revert` growing a hook would.
git_dir=$(git rev-parse --git-dir)
was_pick=0
[ -e "$git_dir/CHERRY_PICK_HEAD" ] && was_pick=1
[ -e "$git_dir/REVERT_HEAD" ] && was_pick=1
msg=$(git log -1 --format=%B)
printf '%s' "$msg" | grep -q '^(cherry picked from commit' && was_pick=1
printf '%s' "$msg" | grep -q '^Revert "' && was_pick=1
[ "$was_pick" -eq 1 ] || exit 0

printf '\033[33mpost-commit: a commit was just authored on %s by cherry-pick/revert.\033[0m\n' "$branch" >&2
cat >&2 <<EOF

  pre-commit cannot intercept those routes, so this is a warning rather than a refusal.

  Just landed: $(git log -1 --oneline)

  To move it onto a branch instead:
    git branch <type>/<short-description>
    git reset --hard HEAD~1
    git switch <type>/<short-description>

EOF
exit 0
