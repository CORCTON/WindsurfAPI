#!/bin/sh
#
# Refuse to author a commit while master/main is checked out.
#
# OPT-IN. Nothing installs this for you:
#     git config core.hooksPath .githooks
# and to bypass it once, for a deliberate exception:
#     git commit --no-verify
#
# Why: the project's flow is branch → review → `git merge --ff-only` → push. Landing
# commits by authoring them directly on master skips the point where a branch name and a
# diff get looked at as a unit. The resulting history is IDENTICAL to the ff-merge, which
# is exactly why the mistake is easy to make and invisible afterwards.
#
# SCOPE, measured rather than assumed — the first version of this comment overstated it:
#   git commit                  BLOCKED
#   git commit --amend          BLOCKED
#   git merge --ff-only         allowed; creates no commit, so the release flow is untouched
#   git cherry-pick             NOT blocked; pre-commit is never consulted. The companion
#                               post-commit hook warns after the fact — it cannot refuse,
#                               but it can say what landed. Verified.
#   git revert                  NOT blocked and NOT WARNED EITHER. Measured: git runs no
#                               post-commit for revert (instrumented the hook with an
#                               unconditional echo; it never printed). This route is
#                               genuinely unguarded — no hook can close it.
#   conflicted merge / rebase   DOES reach git commit, so this hook fires. Its ordinary
#                               "branch first" advice is NOT followable there: git refuses
#                               with "cannot switch branch while merging". Verified. Hence
#                               the state-aware branch below.
branch=$(git symbolic-ref --short -q HEAD) || exit 0   # detached HEAD: not our business

case "$branch" in
  master|main) ;;
  *) exit 0 ;;
esac

git_dir=$(git rev-parse --git-dir)

# Mid-merge / mid-rebase / mid-cherry-pick: the commit is finishing an operation already in
# flight. Blocking is still right (it lands on master), but the ordinary advice cannot be
# followed in this state, and printing an impossible command is worse than printing none.
if [ -e "$git_dir/MERGE_HEAD" ] || [ -e "$git_dir/CHERRY_PICK_HEAD" ] \
   || [ -e "$git_dir/REVERT_HEAD" ] || [ -d "$git_dir/rebase-merge" ] \
   || [ -d "$git_dir/rebase-apply" ]; then
  printf '\033[31mpre-commit: refusing to finish this operation on %s.\033[0m\n' "$branch" >&2
  cat >&2 <<'EOF'

  An operation is already in flight (merge / rebase / cherry-pick), so the usual
  "branch first" advice does NOT apply — git refuses to switch branches mid-operation.

  Either finish deliberately:
    git commit --no-verify

  or back out and redo it on a branch:
    git merge --abort        # or: git rebase --abort / git cherry-pick --abort
    git switch -c <type>/<short-description>

EOF
  exit 1
fi

printf '\033[31mpre-commit: refusing to author a commit on %s.\033[0m\n' "$branch" >&2
cat >&2 <<'EOF'

  The flow is: branch → review → git merge --ff-only → push. Committing straight to
  master produces byte-identical history to that merge, so nothing looks wrong
  afterwards — which is what makes it worth blocking at the moment it happens rather
  than noticing later.

    git switch -c <type>/<short-description>
    git commit ...
    git switch master && git merge --ff-only <branch>

  Deliberate exception: git commit --no-verify

EOF
exit 1
